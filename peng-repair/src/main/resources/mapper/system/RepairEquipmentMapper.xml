    </resultMap>

    <sql id="selectRepairEquipmentVo">
        select id, model, sn, dispatch_img, fault_desc, repair_desc, fault_reason, cause_desc, fault_type_desc, summary, order_time, start_time, salename, status, repair_status, end_time, fault_type, fault_causeid, quality, client, client_add, connection from repair_equipment
    </sql>

    <select id="selectRepairEquipmentList" parameterType="RepairEquipment" resultMap="RepairEquipmentResult">
        <include refid="selectRepairEquipmentVo"/>
        <where>  
            <if test="model != null  and model != ''"> and model = #{model}</if>
            <if test="sn != null  and sn != ''"> and sn = #{sn}</if>
            <if test="quality != null "> and quality = #{quality}</if>
        </where>
    </select>
    
    <select id="selectRepairEquipmentById" parameterType="Long" resultMap="RepairEquipmentResult">
        <include refid="selectRepairEquipmentVo"/>
        where id = #{id}
    </select>

    <insert id="insertRepairEquipment" parameterType="RepairEquipment" useGeneratedKeys="true" keyProperty="id">
        insert into repair_equipment
        <trim prefix="(" suffix=")" suffixOverrides=",">
