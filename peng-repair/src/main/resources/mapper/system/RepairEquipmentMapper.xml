<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.peng.repair.mapper.RepairEquipmentMapper">
    
    <resultMap type="RepairEquipment" id="RepairEquipmentResult">
        <result property="id"    column="id"    />
        <result property="model"    column="model"    />
        <result property="sn"    column="sn"    />
        <result property="dispatchImg"    column="dispatch_img"    />
        <result property="faultDesc"    column="fault_desc"    />
        <result property="repairDesc"    column="repair_desc"    />
        <result property="faultReason"    column="fault_reason"    />
        <result property="summary"    column="summary"    />
        <result property="orderTime"    column="order_time"    />
        <result property="startTime"    column="start_time"    />
        <result property="salename"    column="salename"    />
        <result property="status"    column="status"    />
        <result property="endTime"    column="end_time"    />
        <result property="faultType"    column="fault_type"    />
    </resultMap>

    <sql id="selectRepairEquipmentVo">
        select id, model, sn, dispatch_img, fault_desc, repair_desc, fault_reason, summary, order_time, start_time, salename, status, end_time, fault_type from repair_equipment
    </sql>

    <select id="selectRepairEquipmentList" parameterType="RepairEquipment" resultMap="RepairEquipmentResult">
        <include refid="selectRepairEquipmentVo"/>
        <where>  
            <if test="model != null  and model != ''"> and model like concat('%', #{model}, '%')</if>
            <if test="sn != null  and sn != ''"> and sn like concat('%', #{sn}, '%')</if>
            <if test="params.beginOrderTime != null and params.beginOrderTime != '' and params.endOrderTime != null and params.endOrderTime != ''"> and order_time between #{params.beginOrderTime} and #{params.endOrderTime}</if>
            <if test="salename != null  and salename != ''"> and salename like concat('%', #{salename}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="faultType != null "> and fault_type = #{faultType}</if>
        </where>
    </select>
    
    <select id="selectRepairEquipmentById" parameterType="Long" resultMap="RepairEquipmentResult">
        <include refid="selectRepairEquipmentVo"/>
        where id = #{id}
    </select>

    <insert id="insertRepairEquipment" parameterType="RepairEquipment" useGeneratedKeys="true" keyProperty="id">
        insert into repair_equipment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="model != null">model,</if>
            <if test="sn != null">sn,</if>
            <if test="dispatchImg != null">dispatch_img,</if>
            <if test="faultDesc != null">fault_desc,</if>
            <if test="repairDesc != null">repair_desc,</if>
            <if test="faultReason != null">fault_reason,</if>
            <if test="summary != null">summary,</if>
            <if test="orderTime != null">order_time,</if>
            <if test="startTime != null">start_time,</if>
            <if test="salename != null">salename,</if>
            <if test="status != null">status,</if>
            <if test="endTime != null">end_time,</if>
            <if test="faultType != null">fault_type,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="model != null">#{model},</if>
            <if test="sn != null">#{sn},</if>
            <if test="dispatchImg != null">#{dispatchImg},</if>
            <if test="faultDesc != null">#{faultDesc},</if>
            <if test="repairDesc != null">#{repairDesc},</if>
            <if test="faultReason != null">#{faultReason},</if>
            <if test="summary != null">#{summary},</if>
            <if test="orderTime != null">#{orderTime},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="salename != null">#{salename},</if>
            <if test="status != null">#{status},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="faultType != null">#{faultType},</if>
         </trim>
    </insert>

    <update id="updateRepairEquipment" parameterType="RepairEquipment">
        update repair_equipment
        <trim prefix="SET" suffixOverrides=",">
            <if test="model != null">model = #{model},</if>
            <if test="sn != null">sn = #{sn},</if>
            <if test="dispatchImg != null">dispatch_img = #{dispatchImg},</if>
            <if test="faultDesc != null">fault_desc = #{faultDesc},</if>
            <if test="repairDesc != null">repair_desc = #{repairDesc},</if>
            <if test="faultReason != null">fault_reason = #{faultReason},</if>
            <if test="summary != null">summary = #{summary},</if>
            <if test="orderTime != null">order_time = #{orderTime},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="salename != null">salename = #{salename},</if>
            <if test="status != null">status = #{status},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="faultType != null">fault_type = #{faultType},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteRepairEquipmentById" parameterType="Long">
        delete from repair_equipment where id = #{id}
    </delete>

    <delete id="deleteRepairEquipmentByIds" parameterType="String">
        delete from repair_equipment where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>