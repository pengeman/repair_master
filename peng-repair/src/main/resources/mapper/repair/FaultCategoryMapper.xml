<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.peng.repair.mapper.FaultCategoryMapper">

    <resultMap type="FaultCategory" id="FaultCategoryResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
    </resultMap>

    <select id="selectFaultCategoryList" resultMap="FaultCategoryResult">
        select id, name from fault_categories
        order by id
    </select>

</mapper>
