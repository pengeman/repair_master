<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>新建报修</title>
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>
<body>
    <a href="index.html"><img src="home.png" width="22" height="22" alt="goto home"/></a>--
    <h2>新建维修工单</h2>
    <form action="/api/repair/create" method="post" enctype="multipart/form-data">
    	 <p>业务员：<input type="text" name="salename"  required maxlength="16"></p>
        <p>设备型号：<input type="text" name="model" required maxlength="16"></p>
        <p>设备编号：<input type="text" name="sn" required maxlength="32"></p>
        <p>派工单(图片)：<input type="file" name="dispatch_img" accept="image/*" required></p>
        <p>故障说明：<br><textarea name="fault_desc" rows="3" style="width:100%"></textarea></p>
        <p>维修说明：<br><textarea name="repair_desc" rows="3" style="width:100%"></textarea></p>
        <button type="submit" style="padding: 10px 20px;">确认接单</button>
        <a href="index.html">返回</a>
    </form>
</body>
</html>