<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>过程跟踪</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <style>
        .step-item {
            border-left: 2px solid #007bff;
            padding-left: 10px;
            margin-bottom: 20px;
        }

        .media-box {
            max-width: 200px;
            display: block;
            margin-top: 5px;
        }
    </style>
</head>

<body>
    <h3><a href="index.html">Home </a> 设备维修过程 [<span id="hint"></span>]</h3>

    <section style="background: #f4f4f4; padding: 10px;">
        <label>维修开始时间：</label>
        <input type="datetime-local" id="start_time_input">
        <button onclick="updateStartTime()">更新时间</button>
    </section>

    <hr>

    <h4>维修情况 (图片/视频)</h4>
    <form id="processForm" enctype="multipart/form-data">
        <p>影像采集：<input type="file" name="media" accept="image/*,video/*" capture="camera"></p>
        <p>过程说明：<input type="text" name="desc" placeholder="简要描述此步骤" style="width:80%"></p>
        <button type="button" onclick="uploadStep()">上传记录</button>
    </form>

    <hr>

    <h4>跟踪记录轴</h4>
    <div id="process-list">
        <div class="step-item">
            <small>2024-05-10 14:00</small>
            <p>拆卸外壳检查电路</p>
            <img src="/pics/sample.jpg" class="media-box">
        </div>
    </div>

    <hr>

    <h4>维修总结</h4>
    <button onclick="generateSummary()">自动生成总结</button>
    <textarea id="summary-text" rows="4" style="width:100%; margin-top:10px;" placeholder="点击上方按钮自动生成，可手动修改"></textarea>
    <button style="margin-top:5px;">保存总结并完工</button>

    <script>
        $(document).ready(function () {
            // 页面加载完成后调用获取列表函数
            begin();
        });
        // 自动初始化当前时间到输入框 [cite: 14]
        document.getElementById('start_time_input').value = new Date().toISOString().slice(0, 16);

        function updateStartTime() {
            const time = document.getElementById('start_time_input').value;
            alert("已尝试更新开始时间为: " + time);
            // 这里调用 /api/repair/set-start-time/{id}
        }

        function generateSummary() {
            // 模拟从后端获取拼接好的说明文字 [cite: 12]
            const steps = document.querySelectorAll('.step-item p');
            let result = "";
            steps.forEach(p => result += p.innerText + "；");
            document.getElementById('summary-text').value = "维修完成。经过：" + result;
        }

        function begin() {
             // 1. 从当前 URL 中获取主表记录的 ID (假设 URL 格式为 track.html?id=xxx)
            const urlParams = new URLSearchParams(window.location.search);
            const mainId = urlParams.get('id');
            if (!mainId) {
                alert("错误：未找到有效的设备记录 ID");
                return;
            }
            $.get('/api/repair/detailfortrack/' + mainId, function (data) {
                $('#hint').text(data.salename + " " + data.model + " " + data.sn);
            })
        }
        function uploadStep() {
 // 1. 从当前 URL 中获取主表记录的 ID (假设 URL 格式为 track.html?id=xxx)
            const urlParams = new URLSearchParams(window.location.search);
            const mainId = urlParams.get('id');
            if (!mainId) {
                alert("错误：未找到有效的设备记录 ID");
                return;
            }
        // 2. 获取表单数据
        const fileInput = document.querySelector('input[name="media"]');
        const descInput = document.querySelector('input[name="desc"]');

        if (fileInput.files.length === 0) {
            alert("请先采集影像（图片或视频）");
            return;
        }

        if (!descInput.value.trim()) {
            alert("请输入过程说明");
            return;
        }

        // 3. 构建 FormData 对象以支持文件上传 [cite: 17]
        const formData = new FormData();
        formData.append('media', fileInput.files[0]);
        formData.append('desc', descInput.value);

        // 4. 使用 AJAX 提交数据到后端接口 [cite: 16]
        // 接口路径示例：/api/repair/add-process/{mainId}
        fetch(`/api/repair/add-process/${mainId}`, {
            method: 'POST',
            body: formData
        })
            .then(response => {
                if (response.ok) {
                    alert("步骤记录上传成功！");
                    // 清空输入框以便下次记录
                    descInput.value = "";
                    fileInput.value = "";
                    // 刷新页面或局部刷新列表以显示最新记录 
                    location.reload();
                } else {
                    alert("上传失败，服务器响应异常");
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert("上传出错，请检查网络或服务器状态");
            });
        }
    </script>
</body>

</html>