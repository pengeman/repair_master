<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>工单详情</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <style>
        .step-item {
            border-left: 2px solid #007bff;
            padding-left: 10px;
            margin-bottom: 20px;
        }

        .media-box {
            max-width: 200px;
            display: block;
            margin-top: 5px;
        }
    </style>
</head>

<body>
    <div class="container mt-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <a href="index.html"><img src="home.png" width="22" height="22" alt="goto home"/></a>-- <h5 class="mb-0">工单详情</h5>
                <span id="det-status" class="badge"></span>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="row g-3">
                            <div class="col-6"><strong>设备型号：</strong> <span id="det-model"></span></div>
                            <div class="col-6"><strong>设备编号：</strong> <span id="det-sn"></span></div>
                            <div class="col-6"><strong>接单时间：</strong> <span id="det-order-time"></span></div>
                            <div class="col-6"><strong>开始时间：</strong> <span id="det-start-time"></span></div>

                            <div class="col-12 border-top pt-2">
                                <strong>故障说明：</strong>
                                <p id="det-fault" class="bg-light p-2 rounded mt-1"></p>
                            </div>
                            <div class="col-12">
                                <strong>维修要求/方法：</strong>
                                <p id="repair_desc" class="bg-light p-2 rounded mt-1"></p>
                            </div>
                            <div class="col-12">
                                <strong>故障原因：</strong>
                                <p id="det-reason" class="text-danger"></p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 text-center border-start">
                        <strong class="d-block mb-2">原始派工单</strong>
                        <img id="det-dispatch-img" src="" class="img-thumbnail"
                            style="max-height: 250px; cursor: pointer;" onclick="window.open(this.src)">
                    </div>
                </div>
            </div>
        </div>

    </div>
</body>

</html>
<script>
    $(document).ready(function () {
        // 页面加载完成后调用获取列表函数
        loadFullDetail();
    });

    // 在 loadFullDetail 函数中补充字段填充
    function loadFullDetail() {
        //  从当前 URL 中获取主表记录的 ID (假设 URL 格式为 track.html?id=xxx)
        const urlParams = new URLSearchParams(window.location.search);
        const mainId = urlParams.get('id');

        if (!mainId) {
            alert("错误：未找到有效的设备记录 ID");
            return;
        }
        $.get('/api/repair/detail/' + mainId, function (data) {
            $('#det-model').text(data.model);
            $('#det-sn').text(data.sn);
            $('#det-order-time').text(data.order_time);
            $('#det-start-time').text(data.start_time || "未开始");
            $('#det-fault').text(data.fault_desc);
            $('#repair_desc').text(data.repair_desc);  // 维修说明
            $('#det-reason').text(data.fault_reason || "尚未诊断");

            // 加载派工单图片 (假设存放在 pics 目录)
            $('#det-dispatch-img').attr('src', '/pics/' + data.dispatch_img);

            // ... 原有的过程轴加载逻辑 ...
        });
    }
</script>